# Copy to secret.env (ignored by git) and fill in. kustomize turns it into the
# Secret bulk-mailer-secrets; `kubectl apply -k` fails until the file exists.

# Signs session cookies AND derives the key encrypting stored SMTP/LDAP
# passwords. Changing it later logs everyone out and invalidates those
# passwords. Generate once:  openssl rand -base64 36
SECRET_KEY=

# The first admin's password. Read only while the user table is empty - after
# the first start, change it in the UI or with `python -m app.cli set-password`.
ADMIN_PASSWORD=

# Only if your SMTP server needs authentication.
SMTP_PASSWORD=

# Only for an external PostgreSQL you manage yourself; leave unset for SQLite
# on the volume. (overlays/postgres sets this for you.)
# DATABASE_URL=postgresql+psycopg://mailer:password@db.example.internal:5432/mailer
