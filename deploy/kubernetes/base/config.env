# Non-secret settings, passed to the app as environment variables. Everything
# under Settings in the UI is stored in the database and overrides the SMTP
# values here, so these only matter until someone saves that page.

# The address people and recipients reach the app at. Unsubscribe links in
# every message are built from it, and an https:// value marks the session
# cookie Secure - so set it to your Ingress host, not a cluster-internal name.
PUBLIC_BASE_URL=https://mailer.example.com

ADMIN_USERNAME=admin

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# none | starttls | ssl
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Bulk Mailer

DEFAULT_THROTTLE_PER_MINUTE=60
