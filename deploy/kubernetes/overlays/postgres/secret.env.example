# Copy to secret.env (ignored by git) and fill in.
#
# Used both to initialise the database and inside the app's DATABASE_URL, so
# keep to letters and digits - "@", "/" or ":" would break that URL.
# Generate one:  openssl rand -hex 24
#
# Read by PostgreSQL only when it creates an empty data directory: changing it
# here later does not change the database's password.
POSTGRES_PASSWORD=
