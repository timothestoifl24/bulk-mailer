# Copy to .env and adjust. Never commit the real .env.

# --- Application ---
# Used for session cookies AND to derive the key that encrypts stored
# SMTP/LDAP passwords. Changing it invalidates both.
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL (recommended for anything shared or multi-instance):
DATABASE_URL=postgresql+psycopg://mailer:mailer_dev_pw@127.0.0.1:5432/mailer
# ...or zero-setup SQLite, fine for a single process on one machine:
# DATABASE_URL=sqlite:///./data/mailer.db

DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Bootstrap admin, created on first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Default SMTP (editable later in the UI, stored in the DB) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls          # none | starttls | ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Mailer
SMTP_TIMEOUT=30

# Default throttle for new campaigns (messages per minute, 0 = unlimited)
DEFAULT_THROTTLE_PER_MINUTE=60

# Public base URL, used to build unsubscribe links inside the emails.
PUBLIC_BASE_URL=http://127.0.0.1:8000
